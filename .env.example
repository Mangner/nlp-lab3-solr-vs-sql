# Skopiuj do .env (cp .env.example .env / copy .env.example .env) i dostosuj.

# --- PostgreSQL (używane przez docker-compose.yml i przez kod Pythona) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=lab3
PG_PASSWORD=lab3
PG_DATABASE=lab3

# --- Solr ---
SOLR_HOST=localhost
SOLR_PORT=8983
# pamięć sterty JVM Solra (docker-compose.yml); reszta RAM zostaje na cache plików indeksu
SOLR_HEAP=2g

# --- Dane ---
# liczba rekordów arXiv do pobrania/załadowania (100% zbioru = ta wartość)
NUM_RECORDS=1000000
# katalog z danymi (parquet/CSV); w kontenerze Postgresa jest montowany jako /data (tylko do odczytu)
DATA_DIR=data
# katalog na wyniki pomiarów i wykresy
RESULTS_DIR=results
# ziarno losowania podzbiorów 10% / 50% (powtarzalność)
RANDOM_SEED=42
